{
  "info": {
    "name": "Module 3 Campus Idea Board Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "createdId",
      "value": ""
    },
    {
      "key": "countBeforeInvalid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Greeting",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hello",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "hello"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has message\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Read ideas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ideas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ideas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Create idea",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ideas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ideas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Start a robotics club\",\"category\":\"clubs\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Created idea fields\", () => { const idea = pm.response.json(); pm.expect(idea.id).to.be.a(\"number\"); pm.expect(idea.title).to.eql(\"Start a robotics club\"); pm.expect(idea.category).to.eql(\"clubs\"); pm.collectionVariables.set(\"createdId\", String(idea.id)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Find created idea",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ideas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ideas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created idea is listed\", () => { const id = Number(pm.collectionVariables.get(\"createdId\")); pm.expect(pm.response.json().some(idea => idea.id === id)).to.eql(true); pm.collectionVariables.set(\"countBeforeInvalid\", String(pm.response.json().length)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5 Reject blank title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ideas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ideas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"   \",\"category\":\"clubs\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Reject broken JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ideas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ideas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Broken JSON\",\"category\": }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 Check invalid requests did not add ideas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ideas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ideas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"List count unchanged\", () => pm.expect(pm.response.json().length).to.eql(Number(pm.collectionVariables.get(\"countBeforeInvalid\"))));"
            ]
          }
        }
      ]
    }
  ]
}
